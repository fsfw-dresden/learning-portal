#!/usr/bin/make -f

export PYBUILD_NAME=learning-portal
export DH_VERBOSE=1
export PYBUILD_BUILD_ARGS=--no-isolation
export PYBUILD_SYSTEM=pyproject
export PYBUILD_INSTALL_ARGS=--install-scripts=/usr/bin

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_clean:
	dh_auto_clean
	rm -rf learning-portal
	rm -f dist/*.deb
	rm -rf .pytest_cache
	rm -rf src/*.egg-info
	rm -rf build
	rm -rf .pybuild

override_dh_auto_build:
	# Build Python package
	dh_auto_build
	# Build translations
	for package in welcome tutor portal; do \
			for ts in *.ts; do \
				lrelease src/$$package/translations/$$ts; \
			done \
	done	

override_dh_auto_test:
	@echo "Skipping tests"

override_dh_auto_install:
	dh_auto_install
	# Install pip dependencies
	PYTHONPATH=debian/learning-portal/usr/lib/python3/dist-packages pip3 install --target=debian/learning-portal/usr/lib/python3/dist-packages "dataclass-wizard[all]>=0.22.0" typing-extensions>=4.7.0
	# Install markdown tutorials
	mkdir -p debian/learning-portal/usr/share/learning-portal/courses/examples/
	cp -r OER-materials/examples debian/learning-portal/usr/share/learning-portal/courses/
	# Install translations
	mkdir -p debian/learning-portal/usr/share/learning-portal/translations
	cp src/**/translations/*.qm debian/learning-portal/usr/share/learning-portal/translations/
	# Install default config
	mkdir -p debian/learning-portal/etc/xdg/learning-portal
	cp debian/learning-portal-config.yml debian/learning-portal/etc/xdg/learning-portal/
	# Install desktop file and wrapper
	mkdir -p debian/learning-portal/usr/share/applications
	mkdir -p debian/learning-portal/usr/share/learning-portal
	mkdir -p debian/learning-portal/usr/bin
	cp debian/learning-portal.desktop debian/learning-portal/usr/share/applications/
	cp debian/portal-wrapper.sh debian/learning-portal/usr/bin/
	cp debian/learning-portal-logo.png debian/learning-portal/usr/share/learning-portal/
	chmod +x debian/learning-portal/usr/bin/portal-wrapper.sh
